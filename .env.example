# Copy this file to `.env` (same directory) and fill in the values.
# Docker Compose loads it automatically. Never commit `.env` — it contains your bot token.

# Discord bot token (https://discord.com/developers/applications → Bot → Token).
# Remember to enable the Message Content intent on the bot application.
DISCORD_BOT_TOKEN=

# PostgreSQL credentials used by the database, the bot, and the backup sidecar.
POSTGRES_USER=hambot
POSTGRES_PASSWORD=
POSTGRES_DB=hambotdb

# Optional: Discord user ID of the bot owner. Holds the highest permission tier of all
# (tier 4, above guild owners) in every guild — the level for cross-guild/global settings.
# Also the recipient of the watchdog's DM alerts (FR-106).
BOT_OWNER_DISCORD_ID=

# Optional: Discord channel ID of the operator notification channel (FR-117) — where
# errors, failures, and criticals are posted. Can also be set at runtime with !notifychannel.
NOTIFY_CHANNEL_ID=

# Optional: watchdog tuning (defaults in code: check every 5 minutes, alert after the
# gateway has been down 10 minutes, re-alert hourly while a condition persists).
WATCHDOG_CHECK_INTERVAL_MINUTES=
WATCHDOG_GATEWAY_DOWN_ALERT_MINUTES=
WATCHDOG_RE_ALERT_MINUTES=

# Optional: expose the administrative/configuration and user-scoped commands as Discord
# slash commands (FR-110, default false). Text commands keep working either way.
SLASH_COMMANDS_ENABLED=

# Optional: LLM features (design §3.12) — automatic presence/bio updates via the Mistral API.
# Without LLM_API_KEY every LLM feature is inactive. The values below are the shipped
# defaults (also in appsettings.json); empty values fall back to the code defaults anyway.
# LLM_PERSONA overrides the shipped default persona seed; !persona / !settings persona
# set runtime overrides at chat level.
LLM_API_KEY=
LLM_PERSONA=

# Presence/bio update jobs — both off until enabled; each job has its own interval in minutes (floor 1).
# !llm update [presence|bio] triggers an update manually, even while the jobs are off.
LLM_PRESENCE_UPDATES_ENABLED=false
LLM_PRESENCE_INTERVAL_MINUTES=60
LLM_BIO_UPDATES_ENABLED=false
LLM_BIO_INTERVAL_MINUTES=60

# Optional recent-guild-chat context for the prompts (never DMs; output stays generic).
LLM_INCLUDE_CHAT=false
LLM_CHAT_CONTEXT_MAX_MESSAGES=20
LLM_CHAT_CONTEXT_MAX_CHARACTERS=4000

# Per-UTC-day request hard stop; 0 disables the LLM feature set like a missing key.
LLM_DAILY_REQUEST_BUDGET=500

# Optional: the operator-agent MCP endpoint (FR-86, default off) — bot status, guild,
# messaging, and command-execution tools for an agent on the deployment host, over
# streamable HTTP at http://127.0.0.1:2525/mcp. Enabled requires an API key (FR-87);
# every request must carry it as a bearer token. Without the key the endpoint stays down.
# Generate a key with e.g.:  openssl rand -hex 32
MCP_ENABLED=
MCP_API_KEY=
# Optional: the listen address (default http://0.0.0.0:2525; compose publishes it loopback-only).
MCP_LISTEN_URI=

# --- Backups (the `backup` compose service; design §5.2) ---

# Seconds between scheduled backups (default 86400 = 24h).
BACKUP_INTERVAL=86400

# How many of the most recent dumps to keep in the backups volume (default 7).
BACKUP_RETENTION=7

# Seconds between automated restore tests (default 2592000 = 30 days).
BACKUP_TEST_INTERVAL=2592000

# Optional offsite push (FR-82): rclone remote path for S3-compatible storage.
# Leave empty to skip the offsite push. Example: backup:my-bucket/hambotv2
BACKUP_RCLONE_REMOTE=

# Offsite storage credentials (only used when BACKUP_RCLONE_REMOTE is set).
# They configure the rclone remote named "backup" (BACKUP_RCLONE_REMOTE=backup:<path>).
BACKUP_S3_TYPE=s3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
