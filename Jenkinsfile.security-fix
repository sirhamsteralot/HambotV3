// Weekly critical-CVE autofix pipeline for HambotV2 (design §5.4, FR-214).
//
// Point a dedicated Jenkins Pipeline job at this file ("Pipeline script from
// SCM", script path "Jenkinsfile.security-fix") — NOT the main build/deploy job
// and NOT the scan job. The job:
//   - runs via the upstream trigger below: every time the security scan job
//     (SECURITY_JOB) completes — no fixed delay, whenever the scan is done,
//   - takes the LAST RESULT of the security scan job: copyArtifacts from the
//     last build of SECURITY_JOB that archived artifacts (the scan is UNSTABLE
//     exactly when findings exist, so lastSuccessfulBuild would skip the
//     interesting builds — lastWithArtifacts is the right selector),
//   - for every CRITICAL finding with a published fixed version, bumps the
//     matching direct PackageReference (scripts/security/autofix-criticals.sh),
//   - verifies the bump (dotnet build + test) — a red build never produces a PR,
//   - pushes branch security/autofix-criticals and opens a PR (draft by default)
//     via gh — no user intervention needed,
//   - never merges, never deploys, never touches the running stack, and holds
//     no deploy or bot credentials — only a GitHub PAT (contents + pull
//     requests write) in the GITHUB_CREDENTIAL Jenkins credential.
//
// Agent: any agent with the .NET 10 SDK on its PATH — the same install the
// main pipeline and the scan job already require (docs/jenkins-cicd.md §3,
// /opt/dotnet10). No Docker and no extra image is needed: unlike the scan,
// this pipeline never builds a container image, it only runs dotnet build/test
// and git. jq and gh are installed workspace-local below (pinned), exactly
// like the scan's trivy/jq installs.
//
// Also needed on the Jenkins controller:
//   - the "Copy Artifact" plugin (the Scan results stage's copyArtifacts step),
//   - a "Secret text" credential (ID in GITHUB_CREDENTIAL) holding a GitHub
//     PAT with repo scope (contents:read/write, pull_requests:write) on
//     GITHUB_REPO.
//   - outbound network access on the agent (NuGet, GitHub releases for the
//     pinned jq/gh).
//
// Trigger and tool versions are pinned below; bump versions deliberately.

pipeline {
    agent any

    environment {
        DOTNET_ROOT = '/opt/dotnet10'
        PATH = "/opt/dotnet10:${env.WORKSPACE}/.tools:${env.PATH}"
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = '1'

        // The §5.3 scan job whose last archived results this pipeline consumes.
        SECURITY_JOB = 'Hambot V3 security pipeline'

        GITHUB_REPO = 'sirhamsteralot/HambotV3'
        GITHUB_CREDENTIAL = 'github-autofix-pat'  // Jenkins "Secret text": PAT with repo scope
        BASE_BRANCH = 'master'
        FIX_BRANCH = 'security/autofix-criticals'
        AUTOFIX_DRAFT_PR = 'true'                 // draft = suggestion; a human still merges

        JQ_VERSION = '1.7.1'
        GH_VERSION = '2.104.0'
    }

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    triggers {
        // Fire when the scan job finishes, not on a clock: threshold UNSTABLE
        // means the trigger fires for SUCCESS and UNSTABLE — i.e. every
        // completed scan, clean or with findings (the scan is UNSTABLE exactly
        // when HIGH/CRITICAL findings exist, FR-126) — but NOT for FAILURE or
        // ABORTED, so a broken scan (tool/DB failure) never produces a PR.
        upstream(upstreamProjects: "${env.SECURITY_JOB}", threshold: hudson.model.Result.UNSTABLE)
    }

    stages {
        stage('Checkout fix branch') {
            steps {
                // The autofix edits land on a dedicated branch cut from the
                // current base; the job's own SCM checkout stays untouched.
                sh '''
                    git fetch origin "$BASE_BRANCH"
                    git checkout -B "$FIX_BRANCH" "origin/$BASE_BRANCH"
                '''
            }
        }

        stage('Scan results') {
            steps {
                // Last result of the security scan job: its archived
                // security/** tree (SBOMs + cve-report.*.json). A scan whose
                // tooling broke fails here loudly instead of silently fixing
                // nothing — same philosophy as the scan itself (FR-126).
                sh 'mkdir -p scan-results autofix .tools'
                copyArtifacts projectName: "${env.SECURITY_JOB}", selector: lastWithArtifacts(), target: 'scan-results'
                sh 'ls -la scan-results/security/'
            }
        }

        stage('Install tools') {
            steps {
                // Workspace-local pinned jq + gh (same pattern as the scan's
                // trivy/jq installs): nothing global on the agent, the
                // workspace is cleaned with the build. jq is the official
                // static binary; gh is needed to open the PR.
                sh '''
                    curl -sfL -o "$WORKSPACE/.tools/jq" "https://github.com/jqlang/jq/releases/download/jq-$JQ_VERSION/jq-linux-amd64" && chmod +x "$WORKSPACE/.tools/jq"
                    case "$(uname -m)" in
                        x86_64) arch=amd64 ;;
                        aarch64|arm64) arch=arm64 ;;
                        *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;;
                    esac
                    curl -sfL -o /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v$GH_VERSION/gh_${GH_VERSION}_linux_${arch}.tar.gz"
                    tar -xzf /tmp/gh.tar.gz -C /tmp
                    mv "/tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" "$WORKSPACE/.tools/gh"
                    "$WORKSPACE/.tools/jq" --version
                    "$WORKSPACE/.tools/gh" --version
                '''
            }
        }

        stage('Plan fixes') {
            steps {
                // Extracts CRITICAL findings from the scan reports and bumps
                // the direct PackageReference versions in the two .csproj
                // files (highest fixed version within the installed major).
                sh 'scripts/security/autofix-criticals.sh scan-results/security . autofix'
                sh 'cat autofix/report.md'
                script {
                    env.ACTIONABLE = sh(returnStdout: true, script: 'jq -r .changed autofix/plan.json').trim()
                }
                echo "Actionable CRITICAL fixes: ${env.ACTIONABLE}"
            }
        }

        stage('Verify') {
            // A bump that breaks the build or a test must never become a PR.
            when {
                expression { env.ACTIONABLE == 'true' }
            }
            steps {
                sh 'dotnet build HambotV2.sln --configuration Release /warnaserror:nullable'
                sh 'dotnet test HambotV2.sln --configuration Release --no-build'
            }
        }

        stage('Pull request') {
            when {
                expression { env.ACTIONABLE == 'true' }
            }
            steps {
                withCredentials([string(credentialsId: "${env.GITHUB_CREDENTIAL}", variable: 'GH_TOKEN')]) {
                    sh '''
                        set -e
                        git config user.name 'hambot-autofix'
                        git config user.email 'hambot-autofix@users.noreply.github.com'
                        git config credential.helper '!f() { echo "username=x-access-token"; echo "password=$GH_TOKEN"; }; f'

                        git add HambotV2/HambotV2.csproj BotTests/BotTests.csproj autofix/plan.json autofix/report.md autofix/pr-body.md
                        if git diff --cached --quiet; then
                            echo "Nothing to commit — scan findings already fixed on $BASE_BRANCH"
                            exit 0
                        fi
                        git commit -m "chore(security): auto-fix CRITICAL CVEs from the weekly security scan

Generated by Jenkinsfile.security-fix (${BUILD_URL})."
                        # The branch belongs to this automation; force-with-lease
                        # rewrites it each run while refusing to clobber anything
                        # unexpected that appeared on it meanwhile.
                        git push --force-with-lease origin "HEAD:$FIX_BRANCH"

                        existing=$(gh pr list --repo "$GITHUB_REPO" --head "$FIX_BRANCH" --state open \
                            --json number --jq 'if length > 0 then .[0].number | tostring else "" end')
                        if [ -n "$existing" ]; then
                            echo "PR already open for $FIX_BRANCH: #$existing (updated by this push)"
                        else
                            draft_flag=""
                            [ "$AUTOFIX_DRAFT_PR" = "true" ] && draft_flag="--draft"
                            gh pr create --repo "$GITHUB_REPO" --head "$FIX_BRANCH" --base "$BASE_BRANCH" \
                                --title "chore(security): auto-fix CRITICAL vulnerabilities from the weekly security scan" \
                                --body-file autofix/pr-body.md $draft_flag
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            // Keep the consumed scan reports and the fix plan/report for
            // debugging even when a later stage fails.
            archiveArtifacts artifacts: 'scan-results/**,autofix/**', allowEmptyArchive: true
        }

        cleanup {
            cleanWs notFailBuild: true
        }
    }
}
