<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <!-- Clear the default fallback package folders which include Windows paths
         that don't exist in Linux containers -->
    <add key="fallbackPackageFolders" value="" />
  </packageRestore>
  <packageSources>
    <!-- Use the official NuGet v3 feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
