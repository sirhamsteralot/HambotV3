<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-HambotV2-92ca5ea5-2e8d-4f75-9542-f3f89bca7aa1</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <InternalsVisibleTo Include="BotTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Version embedding (FR-76, design §3.9): the raw release tag and commit hash are read
       from git and compiled into the assembly as metadata; the runtime BotVersion provider
       turns them into the reported version string with pure, unit-tested formatting (NFR-17).
       The raw pieces — not a composed version — are embedded so the formatting exists in
       exactly one place. Local and Jenkins agent builds run git here for free (the workspace
       has .git); container builds cannot (the Docker build context excludes .git), so
       Dockerfile/deploy.sh pass the same two values in via these properties. Any git failure
       leaves the properties empty, which the provider turns into the 0.0.0+unknown fallback —
       never a build failure. Stderr is redirected because ConsoleToMSBuild captures it too:
       git's "fatal:" diagnostics on untagged/no-git builds must not become the version. -->
  <!-- Note: the hook must run before GenerateAssemblyInfo's own dependency chain
       (CoreGenerateAssemblyInfo writes the file when GenerateAssemblyInfo's deps are done,
       before any BeforeTargets="GenerateAssemblyInfo" target runs), so the attributes are
       attached ahead of the input-cache hash that gates the file's regeneration. -->
  <Target Name="ComputeBotVersion" BeforeTargets="GetAssemblyAttributes;CreateGeneratedAssemblyInfoInputsCacheFile">
    <Exec Condition="'$(BotVersionTag)' == ''" Command="git describe --tags --match &quot;v*&quot; --abbrev=0 HEAD 2>&quot;$(IntermediateOutputPath)bot-version-tag.err&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BotVersionTag" />
    </Exec>
    <Exec Condition="'$(BotVersionCommit)' == ''" Command="git rev-parse --short=7 HEAD 2>&quot;$(IntermediateOutputPath)bot-version-commit.err&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BotVersionCommit" />
    </Exec>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BotVersionTag</_Parameter1>
        <_Parameter2>$(BotVersionTag)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BotVersionCommit</_Parameter1>
        <_Parameter2>$(BotVersionCommit)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
