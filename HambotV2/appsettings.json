{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hambot-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ]
  },
  "BotConfiguration": {
    "BotName": "HamBot",
    "LogFormat": "{0}: {1}",
    "CommandIdentifier" :  "!",
    "CooldownSecondsByTier": {
      "0": 3,
      "1": 3,
      "2": 2,
      "3": 1
    }
  },
  "QuoteOfTheDay": {
    "MinIntervalMinutes": 1
  },
  "LinkFix": {
    "MaxLinksPerMessage": 5,
    "ChannelCooldownSeconds": 0,
    "MaxMappings": 50,
    "RedditVideoProbe": true,
    "VideoProbeTimeoutSeconds": 5,
    "VideoProbeCacheMinutes": 360,
    "SuppressOriginalEmbeds": true
  },
  "FuelUsageMonitor": {
    "Enabled": false,
    "ListenUri": "http://0.0.0.0:2526",
    "ListenPath": "/fuel/upload",
    "MaxUploadsPerMinute": 120,
    "MaxQueryBytes": 8192,
    "MaxBodyBytes": 8388608
  },
  "Llm": {
    "Model": "mistral-small-latest",
    "PresenceUpdates": {
      "Enabled": false,
      "IntervalMinutes": 60
    },
    "ChatContext": {
      "MaxMessages": 20,
      "MaxCharacters": 4000,
      "MaxAgeHours": 24
    },
    "BioUpdates": {
      "Enabled": false,
      "IntervalMinutes": 60
    },
    "DailyRequestBudget": 500
  }
}
